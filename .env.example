# webznc configuration template. Copy to .env and fill in.
#
# Values below are illustrative placeholders. USER / PASSWORD are literal words
# used only to show which field is which -- replace them with your real ZNC
# account name and password. ZNC_PASS is a real credential; .env is 0600 and
# is never committed (see .gitignore).

ZNC_HOST=127.0.0.1
ZNC_PORT=9999
ZNC_SSL_ENABLED=1
ZNC_USER=USER
ZNC_NET=Rizon
ZNC_PASS=PASSWORD
IRC_NICK=USER
FLASK_PORT=7006
WEBZNC_LOG_LEVEL=INFO
WEBZNC_SSL_NO_VERIFY=1
MAX_MESSAGE_BYTES=400
MAX_TOPIC_BYTES=300
MAX_MESSAGES=1000
RECONNECT_DELAY=5